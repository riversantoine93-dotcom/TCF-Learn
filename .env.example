# Template only. Copy to .env.local for local development and fill in your values.
# Production values belong in Vercel Project Settings > Environment Variables.
# Never commit populated environment files or server-side secrets.

# Required public configuration (exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required server-side configuration for enrollment, payments, and webhooks.
# Keep these private; never prefix them with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Optional course price overrides. Leave blank to use existing application defaults.
STRIPE_TURNING_FORWARD_PRICE_ID=
STRIPE_THOUGHT_TO_FREEDOM_PRICE_ID=
STRIPE_TCF_LEARN_BUNDLE_PRICE_ID=

# Organization prices: configure the 10-seat price for organization checkout.
STRIPE_TCF_ORG_10_PRICE_ID=
# Reserved for the contact-only 50- and 100-seat plans; leave blank unless needed.
STRIPE_TCF_ORG_50_PRICE_ID=
STRIPE_TCF_ORG_100_PRICE_ID=
